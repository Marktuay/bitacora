@page "/blokon"
@page "/conaser"
@page "/security"
@page "/newcentury"
@page "/form.html"
<HeadContent><title>Registro de bitácora</title><link rel="stylesheet" href="/assets/styles.css"><link rel="manifest" href="/manifest.webmanifest"></HeadContent>
<main class="shell"><div class="topbar"><div class="brand"><a href="/" class="mark">NC</a><div><h1 id="pageTitle">Bitácora de KM</h1><p>Registro de gestión y recorrido</p></div></div><div class="nav" data-auth-nav><a class="btn ghost" href="/">Inicio</a></div></div><section class="card form-card"><div id="modeNotice" class="warning" hidden></div><form id="tripForm"><div class="form-grid"><div class="field"><label for="date">Fecha *</label><input id="date" type="date" required></div><div class="field"><label for="employee">Colaborador *</label><select id="employee" required><option value="">Cargando…</option></select></div><div class="field"><label for="vehicleAuto">Vehículo / placa *</label><input id="vehicle" type="hidden"><input id="vehicleAuto" aria-label="Vehículo asociado / placa" readonly placeholder="Se completa al seleccionar al colaborador"><div id="vehicleHint" class="hint"></div></div><div class="field"><label for="area">Área que solicita *</label><select id="area" required></select></div><div class="field"><label for="management">Tipo de gestión</label><input id="management" type="text" placeholder="Escriba la gestión realizada"></div><div class="field"><label for="origin">Desde *</label><input id="origin" required placeholder="Origen del recorrido"></div><div class="field"><label for="destination">Hasta *</label><input id="destination" required placeholder="Destino de la gestión"></div><div class="field"><label for="timeStart">Hora inicial *</label><input id="timeStart" type="time" required></div><div class="field"><label for="timeEnd">Hora final *</label><input id="timeEnd" type="time" required></div><div class="field"><label for="kmInitial">KM inicial *</label><input id="kmInitial" type="number" step="0.1" min="0" required><div id="odoHint" class="hint"></div></div><div class="field photo-field"><label for="odometerStart">Foto odómetro inicial *</label><input id="odometerStart" type="file" accept="image/jpeg,image/png,image/webp" capture="environment" required><div class="hint">Tomá una foto donde se vea claramente el kilometraje inicial.</div></div><div class="field"><label for="kmFinal">KM final *</label><input id="kmFinal" type="number" step="0.1" min="0" required><div id="kmCalc" class="hint">Recorrido: 0 km</div></div><div class="field photo-field"><label for="odometerEnd">Foto odómetro final *</label><input id="odometerEnd" type="file" accept="image/jpeg,image/png,image/webp" capture="environment" required><div class="hint">Tomá una foto donde se vea claramente el kilometraje final.</div></div><div class="field"><label for="reference">Orden / referencia</label><input id="reference" placeholder="Orden, ticket o referencia"></div><div class="field"><label for="result">Resultado</label><select id="result"><option value="">Seleccione</option><option>Realizado</option><option>No realizado</option><option>Cliente ausente</option><option>Dirección incorrecta</option><option>Reprogramado</option></select></div><div class="field full"><label for="observation">Observación</label><textarea id="observation" placeholder="Detalle adicional de la gestión"></textarea></div><div class="field full"><label for="support">Soporte de gestión (opcional)</label><input id="support" type="file" accept="image/jpeg,image/png,image/webp,.pdf"><div class="hint">Foto o PDF adicional. Máximo 3 MB.</div></div><div class="field full"><button id="submitBtn" class="btn primary" type="submit">Guardar gestión</button></div></div></form><div id="successBox" class="success" hidden></div></section></main><script src="/assets/common.js"></script><script src="/assets/auth.js"></script><script src="/assets/form.js"></script>
