@page "/colaboradores"
@page "/colaboradores.html"
<HeadContent><title>Colaboradores · Bitácora KM</title><link rel="stylesheet" href="/assets/styles.css"></HeadContent>
<main class="shell"><div class="topbar"><div class="brand"><a class="mark" href="/">NC</a><div><h1>Registrar colaboradores</h1><p>Alta de empleado, vehículo y cuenta individual</p></div></div><div class="nav" data-auth-nav><a class="btn ghost" href="/auditoria">Revisar recorridos</a><a class="btn ghost" href="/accesos.html">Accesos</a></div></div><section class="card form-card"><form id="employeeForm" class="form-grid"><div class="field full"><label for="company">Empresa</label><select id="company"><option value="blokon">BLOKON</option><option value="conaser">CONASER</option><option value="security">NEW CENTURY SECURITY</option><option value="newcentury">NEW CENTURY</option></select></div><div class="field"><label for="name">Nombre completo *</label><input id="name" required minlength="2" maxlength="200"></div><div class="field"><label for="email">Correo corporativo o personal *</label><input id="email" type="email" required maxlength="254" autocomplete="off"></div><div class="field"><label for="area">Área *</label><input id="area" required minlength="2" maxlength="120" placeholder="Ejemplo: AUDITORÍA"></div><div class="field"><label for="role">Cargo</label><input id="role" maxlength="120"></div><div class="field full"><label for="vehicleId">Vehículo habitual</label><select id="vehicleId"><option value="">Registrar un vehículo nuevo</option></select><span class="hint">Podés asociar un vehículo disponible de esta empresa. Los vehículos asignados se conservan con su colaborador.</span></div><div id="newVehicle" class="field full"><div class="form-grid"><div class="field"><label for="type">Vehículo *</label><input id="type" required minlength="2" maxlength="120" placeholder="Ejemplo: Camioneta"></div><div class="field"><label for="brand">Marca / modelo</label><input id="brand" maxlength="120" placeholder="Ejemplo: Mazda"></div><div class="field"><label for="plate">Placa</label><input id="plate" maxlength="40" placeholder="Puede quedar pendiente"></div></div></div><div class="field full"><button id="saveEmployee" class="btn primary">Registrar y habilitar cuenta</button></div></form><p id="result" role="status" style="white-space:pre-wrap;overflow-wrap:anywhere"></p></section><section class="card" style="margin-top:18px"><h2>Colaboradores de la empresa</h2><div id="employeeList"></div></section></main><script src="/assets/common.js"></script><script src="/assets/auth.js"></script><script src="/assets/team.js"></script>
