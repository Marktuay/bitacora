@page "/recuperar"
@page "/recuperar.html"
<HeadContent><meta name="referrer" content="no-referrer"><title>Recuperar contraseña · Bitácora KM</title><link rel="stylesheet" href="/assets/styles.css"></HeadContent>
<main class="shell" style="max-width:550px"><section class="card"><div class="brand"><img src="/assets/new-century.png" alt="New Century" width="112" height="56" style="object-fit:contain"><div><h1>Recuperar contraseña</h1><p>Usá el correo de tu cuenta</p></div></div>
<p id="recoveryMessage" role="status" aria-live="polite"></p>
<form id="recoverForm"><div class="field"><label for="recoveryEmail">Correo personal registrado</label><input id="recoveryEmail" type="email" autocomplete="username" maxlength="254" required></div><p><button class="btn primary" type="submit">Enviar enlace de recuperación</button></p></form>
<form id="codeForm" hidden><p>Si tu correo trae un código, podés ingresarlo aquí.</p><div class="field"><label for="recoveryCode">Código de 6 dígitos</label><input id="recoveryCode" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required></div><p><button class="btn ghost" type="submit">Verificar código</button></p></form>
<form id="resetForm" hidden><p id="resetEmail"></p><div class="field"><label for="resetPassword">Nueva contraseña</label><input id="resetPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required></div><div class="field" style="margin-top:14px"><label for="resetConfirmation">Confirmar nueva contraseña</label><input id="resetConfirmation" type="password" autocomplete="new-password" minlength="8" maxlength="128" required></div><label style="display:flex;gap:8px;align-items:center;margin-top:14px"><input id="showResetPassword" type="checkbox" style="width:auto">Mostrar contraseña</label><p><button class="btn primary" type="submit">Guardar nueva contraseña</button></p></form>
<p><a class="btn ghost" id="recoveryLogin" href="/login.html?next=%2Fmobile-auth.html">Volver a iniciar sesión</a></p><p>Tus gestiones, fotos y recorridos guardados se conservan.</p></section></main><script src="/assets/recovery.js"></script>
