# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - BITÁCORA KM (GOOGLE CLOUD COMPUTE ENGINE)
# ==============================================================================

# 1. Dominios Corporativos y Certificados SSL Let's Encrypt (Caddy Proxy)
# Reemplazar con los dominios oficiales de New Century apuntados a la IP fija de GCP
APP_DOMAIN=bitacora.newcenturyni.com
GPS_DOMAIN=gps.newcenturyni.com
TLS_EMAIL=informatica@newcenturyni.com

# 2. Base de Datos de Telemetría GPS (Traccar - MySQL 8.4)
GPS_DB_PASSWORD=TraccarSecurePass2026!
GPS_DB_ROOT_PASSWORD=MySQLRootSecurePass2026!

# 3. Base de Datos Corporativa Bitácora KM (PostgreSQL 17)
POSTGRES_DB=bitacora_km_blazor
POSTGRES_USER=bitacora_admin
POSTGRES_PASSWORD=PostgresSecurePass2026!

# 4. Cadena de conexión interna para el servicio Bitácora KM
DATABASE_URL=postgres://bitacora_admin:PostgresSecurePass2026!@postgres-db:5432/bitacora_km_blazor

# 5. Directorio privado para almacenamiento de fotos de odómetros y soportes
BITACORA_DATA_DIR=/var/data/bitacora-soportes
BITACORA_GPS_PROVIDER=traccar
BITACORA_PUBLIC_URL=https://bitacora.newcenturyni.com
